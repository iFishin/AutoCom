{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AutoCom Configuration",
    "description": "AutoCom 设备通信配置文件",
    "type": "object",
    "properties": {
        "Constants": {
            "type": "object",
            "description": "全局常量定义",
            "additionalProperties": {
                "type": "string",
                "description": "常量值"
            }
        },
        "Config": {
            "type": "object",
            "description": "执行配置（可选）—— 指定流水线的执行方式和参数。CLI 参数会覆盖此配置。",
            "properties": {
                "description": {
                    "type": "string",
                    "description": "配置文件的描述（仅用于日志显示）"
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "single",
                        "loop",
                        "infinite"
                    ],
                    "description": "执行模式",
                    "default": "single"
                },
                "loop": {
                    "type": "object",
                    "description": "循环模式配置（仅在 mode=loop 时使用）",
                    "properties": {
                        "iterations": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "循环执行次数（默认: 1）",
                            "default": 1
                        },
                        "interval_ms": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 60000,
                            "description": "两次迭代之间的间隔（毫秒，默认: 0）",
                            "default": 0
                        },
                        "stop_on_failure": {
                            "type": "boolean",
                            "description": "出现失败时是否终止",
                            "default": true
                        },
                        "max_failures": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "最大允许失败次数（0=不限）",
                            "default": 0
                        },
                        "duration": {
                            "type": "string",
                            "description": "目标执行时长，到达后自动停止。格式: 30s(秒), 5m(分), 1h(时)",
                            "default": ""
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "ConfigForDevices": {
            "type": "object",
            "description": "设备通信配置",
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "enabled",
                        "disabled"
                    ],
                    "description": "设备配置状态",
                    "default": "enabled"
                },
                "stop_bits": {
                    "type": "integer",
                    "enum": [
                        1,
                        2
                    ],
                    "description": "停止位",
                    "default": 1
                },
                "parity": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "enum": [
                        null,
                        "none",
                        "even",
                        "odd",
                        "mark",
                        "space"
                    ],
                    "description": "奇偶校验位",
                    "default": null
                },
                "data_bits": {
                    "type": "integer",
                    "enum": [
                        5,
                        6,
                        7,
                        8
                    ],
                    "description": "数据位",
                    "default": 8
                },
                "flow_control": {
                    "type": "object",
                    "description": "流控制配置",
                    "properties": {
                        "xon_xoff": {
                            "type": "boolean",
                            "description": "软件流控",
                            "default": false
                        },
                        "rts_cts": {
                            "type": "boolean",
                            "description": "硬件流控 RTS/CTS",
                            "default": false
                        },
                        "dsr_dtr": {
                            "type": "boolean",
                            "description": "硬件流控 DSR/DTR",
                            "default": false
                        }
                    },
                    "additionalProperties": false
                },
                "dtr": {
                    "type": "boolean",
                    "description": "数据终端就绪",
                    "default": false
                },
                "rts": {
                    "type": "boolean",
                    "description": "请求发送",
                    "default": false
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "Devices": {
            "type": "array",
            "description": "设备列表",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
                        "description": "设备名称（唯一标识）",
                        "examples": [
                            "DeviceA",
                            "DeviceB",
                            "SIM800_Module"
                        ]
                    },
                    "port": {
                        "type": "string",
                        "pattern": "^(COM\\d+|/dev/tty[A-Z]{3}\\d+|/dev/cu\\.[a-zA-Z0-9_-]+)$",
                        "description": "串口号（Windows: COMx, Linux: /dev/ttyXXX, Mac: /dev/cu.XXX）",
                        "examples": [
                            "COM13",
                            "COM1",
                            "/dev/ttyUSB0",
                            "/dev/cu.usbserial-123"
                        ]
                    },
                    "baud_rate": {
                        "type": "integer",
                        "enum": [
                            300,
                            1200,
                            2400,
                            4800,
                            9600,
                            19200,
                            38400,
                            57600,
                            115200,
                            230400,
                            460800,
                            921600,
                            1000000,
                            1152000,
                            1500000,
                            2000000,
                            2500000
                        ],
                        "description": "波特率",
                        "default": 115200
                    },
                    "monitor": {
                        "type": "boolean",
                        "description": "是否监控该设备的串口输出（仅在 ConfigForDevices.status 为 enabled 时生效）",
                        "default": false
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "enabled",
                            "disabled"
                        ],
                        "description": "设备配置状态",
                        "default": "enabled"
                    }
                },
                "required": [
                    "name",
                    "port",
                    "baud_rate"
                ],
                "additionalProperties": false
            },
            "minItems": 0
        },
        "Steps": {
            "type": "array",
            "description": "流水线步骤列表（新增，替代 Commands）",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "步骤唯一标识"
                    },
                    "name": {
                        "type": "string",
                        "description": "步骤名称（仅用于日志/显示）"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "serial",
                            "serial_wait",
                            "http",
                            "script",
                            "wait",
                            "action_batch"
                        ],
                        "description": "步骤类型",
                        "default": "serial"
                    },
                    "order": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "默认执行顺序（数字越小越先执行）"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "enabled",
                            "disabled"
                        ],
                        "default": "enabled"
                    },
                    "timeout": {
                        "type": "integer",
                        "minimum": 100,
                        "maximum": 600000,
                        "description": "超时时间（毫秒）"
                    },
                    "ignore_error": {
                        "type": "boolean",
                        "description": "是否忽略该步骤的错误",
                        "default": false
                    },
                    "delay_after": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000,
                        "description": "执行后延迟（毫秒）"
                    },
                    "if": {
                        "type": "string",
                        "description": "条件跳过：表达式为 false 时跳过本步。例: \"{{ steps.check.status }} == passed\""
                    },
                    "unless": {
                        "type": "string",
                        "description": "条件跳过：表达式为 true 时跳过本步（if 的反向）"
                    },
                    "on_success": {
                        "type": "string",
                        "description": "成功后的控制流: 'continue', 'goto(id)', 'skip'",
                        "default": "continue"
                    },
                    "on_error": {
                        "type": "string",
                        "description": "失败后的控制流: 'abort', 'retry(3)', 'goto(id)', 'skip'",
                        "default": "abort"
                    },
                    "capture": {
                        "type": "object",
                        "description": "从响应中提取变量（替代旧 variables）",
                        "additionalProperties": {
                            "type": "string",
                            "description": "正则表达式"
                        }
                    },
                    "success_actions": {
                        "type": "array",
                        "description": "成功后执行的 actions",
                        "items": {
                            "$ref": "./actions.schema.json#/definitions/action"
                        },
                        "default": []
                    },
                    "error_actions": {
                        "type": "array",
                        "description": "失败后执行的 actions",
                        "items": {
                            "$ref": "./actions.schema.json#/definitions/action"
                        },
                        "default": []
                    }
                },
                "required": [
                    "id",
                    "type"
                ],
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "type": {
                                    "const": "serial"
                                }
                            }
                        },
                        "then": {
                            "required": [
                                "device"
                            ],
                            "properties": {
                                "send": {
                                    "type": "string",
                                    "description": "串口发送内容"
                                },
                                "device": {
                                    "type": "string",
                                    "description": "设备名称（须匹配 Devices 中的 name）"
                                },
                                "expect": {
                                    "type": "array",
                                    "description": "期望响应列表",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "encoding": {
                                    "type": "string",
                                    "enum": [
                                        "ascii",
                                        "hex"
                                    ],
                                    "description": "编码方式"
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "type": {
                                    "const": "serial_wait"
                                }
                            }
                        },
                        "then": {
                            "required": [
                                "device",
                                "expect"
                            ],
                            "properties": {
                                "device": {
                                    "type": "string",
                                    "description": "设备名称（须匹配 Devices 中的 name）"
                                },
                                "expect": {
                                    "type": "array",
                                    "description": "期望响应列表",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "timeout": {
                                    "type": "integer",
                                    "minimum": 100,
                                    "maximum": 600000,
                                    "description": "超时时间（毫秒）"
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "type": {
                                    "const": "http"
                                }
                            }
                        },
                        "then": {
                            "required": [
                                "url"
                            ],
                            "properties": {
                                "url": {
                                    "type": "string",
                                    "description": "请求 URL"
                                },
                                "method": {
                                    "type": "string",
                                    "enum": [
                                        "GET",
                                        "POST",
                                        "PUT",
                                        "DELETE"
                                    ],
                                    "default": "GET"
                                },
                                "headers": {
                                    "type": "object",
                                    "description": "请求头"
                                },
                                "body": {
                                    "type": "object",
                                    "description": "请求体"
                                },
                                "ignore_error": {
                                    "type": "boolean",
                                    "description": "为 true 时，无论请求成功还是失败都判定为 passed",
                                    "default": false
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "type": {
                                    "const": "script"
                                }
                            }
                        },
                        "then": {
                            "required": [
                                "command"
                            ],
                            "properties": {
                                "command": {
                                    "type": "string",
                                    "description": "要执行的命令"
                                },
                                "working_dir": {
                                    "type": "string",
                                    "description": "工作目录"
                                },
                                "shell": {
                                    "type": "boolean",
                                    "default": true,
                                    "description": "是否通过 shell 执行"
                                },
                                "env": {
                                    "type": "object",
                                    "description": "环境变量"
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "type": {
                                    "const": "wait"
                                }
                            }
                        },
                        "then": {
                            "required": [
                                "duration"
                            ],
                            "properties": {
                                "duration": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "等待时长（毫秒）"
                                }
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "type": {
                                    "const": "action_batch"
                                }
                            }
                        },
                        "then": {
                            "required": [
                                "actions"
                            ],
                            "properties": {
                                "actions": {
                                    "type": "array",
                                    "description": "要执行的 actions 列表",
                                    "items": {
                                        "$ref": "./actions.schema.json#/definitions/action"
                                    }
                                }
                            }
                        }
                    }
                ]
            }
        },
        "ConfigForCommands": {
            "type": "object",
            "description": "命令执行全局配置",
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "enabled",
                        "disabled"
                    ],
                    "description": "命令配置状态",
                    "default": "enabled"
                },
                "timeout": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 60000,
                    "description": "全局超时时间（毫秒）",
                    "default": 4000
                },
                "concurrent_strategy": {
                    "type": "string",
                    "enum": [
                        "sequential",
                        "parallel",
                        "batch"
                    ],
                    "description": "并发执行策略",
                    "default": "sequential"
                },
                "error_actions": {
                    "type": "array",
                    "description": "错误处理策略",
                    "items": {
                        "$ref": "./actions.schema.json#/definitions/action"
                    },
                    "default": []
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "Commands": {
            "type": "array",
            "description": "[废弃] 旧版命令列表，建议改用 Steps。为向后兼容仍可解析。",
            "items": {
                "type": "object",
                "properties": {
                    "command": {
                        "type": "string",
                        "description": "AT 命令",
                        "examples": [
                            "AT+QECHO=1",
                            "AT+CSUB",
                            "AT+CSQ",
                            "AT+CREG?"
                        ]
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "enabled",
                            "disabled"
                        ],
                        "description": "命令配置状态",
                        "default": "enabled"
                    },
                    "expected_responses": {
                        "type": "array",
                        "description": "期望的响应列表（顺序依次匹配）",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        },
                        "minItems": 1,
                        "uniqueItems": true,
                        "examples": [
                            [
                                "OK"
                            ],
                            [
                                "OK",
                                "CONNECT"
                            ],
                            [
                                "SubEdition: V01"
                            ]
                        ]
                    },
                    "hex_mode": {
                        "type": "boolean",
                        "description": "是否按十六进制发送命令",
                        "default": false
                    },
                    "priority": {
                        "type": "integer",
                        "description": "命令优先级（值越大越优先，主要用于 monitor 场景）",
                        "default": 0
                    },
                    "completion_rules": {
                        "type": "object",
                        "description": "命令完成判定规则（monitor 场景可用）",
                        "properties": {
                            "expected_required": {
                                "type": "boolean",
                                "description": "命中终止词后是否仍需等待 expected_responses",
                                "default": false
                            },
                            "terminal_patterns": {
                                "type": "array",
                                "description": "终止词列表",
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "default": [
                                    "OK",
                                    "ERROR"
                                ]
                            },
                            "complete_patterns": {
                                "type": "array",
                                "description": "自定义完成词列表，命中任意一项即可完成",
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "default": []
                            },
                            "idle_timeout": {
                                "type": "number",
                                "minimum": 0,
                                "description": "响应空闲收敛超时（秒）"
                            },
                            "settle_after_terminal": {
                                "type": "number",
                                "minimum": 0,
                                "description": "命中终止词后额外收敛等待（秒）"
                            }
                        },
                        "additionalProperties": false
                    },
                    "device": {
                        "type": "string",
                        "description": "执行命令的设备名称（必须与 Devices 中的 name 匹配）",
                        "$comment": "动态验证：应匹配 Devices 数组中的某个 name"
                    },
                    "order": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "命令执行顺序",
                        "examples": [
                            1,
                            2,
                            3
                        ]
                    },
                    "timeout": {
                        "type": "integer",
                        "description": "单条命令超时时间（毫秒），优先级高于全局配置",
                        "default": 1000
                    },
                    "delay_after": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000,
                        "description": "命令执行后延迟（毫秒）",
                        "default": 0
                    },
                    "ignore_error": {
                        "type": "boolean",
                        "description": "是否忽略该命令的错误",
                        "default": false
                    },
                    "variables": {
                        "type": "object",
                        "description": "从响应中提取的变量",
                        "additionalProperties": {
                            "type": "string",
                            "description": "正则表达式，用于提取响应内容"
                        },
                        "examples": [
                            {
                                "signal_strength": "\\+CSQ: (\\d+),"
                            }
                        ]
                    },
                    "success_actions": {
                        "type": "array",
                        "description": "命令成功后的动作列表",
                        "items": {
                            "$ref": "./actions.schema.json#/definitions/action"
                        },
                        "default": []
                    },
                    "error_actions": {
                        "type": "array",
                        "description": "命令失败后的动作列表",
                        "items": {
                            "$ref": "./actions.schema.json#/definitions/action"
                        },
                        "default": []
                    }
                },
                "required": [
                    "command",
                    "expected_responses",
                    "device",
                    "order"
                ],
                "additionalProperties": false
            },
            "minItems": 1
        }
    },
    "required": [],
    "additionalProperties": false
}